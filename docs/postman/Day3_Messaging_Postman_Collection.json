{
  "info": {
    "name": "Connect App - Day 3 Messaging Flow",
    "description": "Bộ kịch bản kiểm thử toàn diện cho Day 3: Quản lý cuộc trò chuyện 1-1 và Tin nhắn (REST API)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "userA_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "userB_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenC",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Khởi tạo & Đăng nhập (Setup Users & Login)",
      "item": [
        {
          "name": "1.1 Đăng ký User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('userA_id', json.data.id);",
                  "        console.log('✅ Đã lưu userA_id:', json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usera_day3@example.com\",\n  \"username\": \"usera_day3\",\n  \"password\": \"Password123@\",\n  \"displayName\": \"User A Day 3\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Đăng nhập User A (Lấy Token A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set('tokenA', json.data.accessToken);",
                  "        if (json.data.user && json.data.user.id) {",
                  "            pm.collectionVariables.set('userA_id', json.data.user.id);",
                  "        }",
                  "        console.log('✅ Đã lưu tokenA');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usera_day3@example.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
